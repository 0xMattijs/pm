#!/usr/bin/env bash
f="$1"; dir="$(git rev-parse --show-toplevel)/{{ path }}"
case "$f" in "$dir"/node_modules/*|"$dir"/ios/*|"$dir"/android/*) exit 0 ;; esac
case "$f" in "$dir"/*.ts|"$dir"/*.tsx|"$dir"/*.js|"$dir"/*.jsx|"$dir"/*.json) ;; *) exit 0 ;; esac
out=$(pnpm --dir "$dir" exec biome check --write --no-errors-on-unmatched "$f" 2>&1) || { echo "$out" >&2; exit 2; }
exit 0
